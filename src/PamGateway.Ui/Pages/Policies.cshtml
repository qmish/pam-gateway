@page
@model PoliciesModel
@{
    ViewData["Title"] = "Policies";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Policies</h2>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Target Type</th>
        <th>Protocols</th>
        <th>Effect</th>
        <th>Selector</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var policy in Model.Policies)
    {
        <tr>
            <td>@policy.Id</td>
            <td>@policy.Name</td>
            <td>@policy.TargetType</td>
            <td>@policy.AllowedProtocols</td>
            <td>@policy.Effect</td>
            <td>@string.Join(", ", policy.TargetLabelSelector?.Select(kvp => $"{kvp.Key}={kvp.Value}") ?? Array.Empty<string>())</td>
        </tr>
    }
    </tbody>
</table>

<h4 class="mt-4">Create policy</h4>
<form method="post" class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Name</label>
        <input asp-for="Form.Name" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Target Type</label>
        <input asp-for="Form.TargetType" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Protocols</label>
        <input asp-for="Form.AllowedProtocols" class="form-control" placeholder="RDP, SSH" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Effect</label>
        <input asp-for="Form.Effect" class="form-control" placeholder="Allow/Deny" />
    </div>
    <div class="col-md-9">
        <label class="form-label">Target Label Selector</label>
        <input asp-for="Form.TargetLabelSelector" class="form-control" placeholder="os=windows, access=rdp" />
        <div class="form-text">Формат: key=value, разделитель запятая или точка с запятой.</div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>
