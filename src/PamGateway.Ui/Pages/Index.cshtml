@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">PAM Gateway UI</h1>
    <p>Управление подключениями и агентами.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Targets</h5>
                <p class="card-text">Список систем и их параметры подключения.</p>
                <a class="btn btn-primary" asp-page="/Targets">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Policies</h5>
                <p class="card-text">Политики доступа и label-селекторы.</p>
                <a class="btn btn-primary" asp-page="/Policies">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Roles</h5>
                <p class="card-text">Роли доступа и описания.</p>
                <a class="btn btn-primary" asp-page="/Roles">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Agents</h5>
                <p class="card-text">Состояние агентов и их возможности.</p>
                <a class="btn btn-primary" asp-page="/Agents">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Sessions</h5>
                <p class="card-text">Активные и завершенные сессии.</p>
                <a class="btn btn-primary" asp-page="/Sessions">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Recordings</h5>
                <p class="card-text">Записи сессий и их статусы.</p>
                <a class="btn btn-primary" asp-page="/Recordings">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Access Requests</h5>
                <p class="card-text">Заявки на JIT доступ и статусы.</p>
                <a class="btn btn-primary" asp-page="/AccessRequests">Открыть</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">Approvals</h5>
                <p class="card-text">История согласований и решений.</p>
                <a class="btn btn-primary" asp-page="/Approvals">Открыть</a>
            </div>
        </div>
    </div>
</div>
