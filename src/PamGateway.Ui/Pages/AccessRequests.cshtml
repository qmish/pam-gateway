@page
@model AccessRequestsModel
@{
    ViewData["Title"] = "Access Requests";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Access Requests</h2>
</div>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input asp-for="Search" class="form-control" placeholder="Id / Target / User / ITSM" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="">All</option>
            @foreach (var status in Model.StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Target</label>
        <select asp-for="TargetId" class="form-select">
            <option value="">All</option>
            @foreach (var target in Model.Targets)
            {
                <option value="@target.Id">@target.Name (@target.Id)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="table-responsive">
<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Id</th>
        <th>Target</th>
        <th>Requested By</th>
        <th>Duration</th>
        <th>Status</th>
        <th>Expires At</th>
        <th>ITSM</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var request in Model.Requests)
    {
        var statusBadge = request.Status.ToLowerInvariant() switch
        {
            "pending" => "bg-warning text-dark",
            "approved" => "bg-success",
            "denied" => "bg-danger",
            "expired" => "bg-secondary",
            _ => "bg-info"
        };
        var steps = new[] { "Pending", "Approved", "Active", "Expired" };
        var currentStep = request.Status.ToLowerInvariant() switch
        {
            "pending" => 0,
            "approved" => 1,
            "denied" => -1,
            "expired" => 3,
            _ => 0
        };
        <tr>
            <td><code>@request.Id</code></td>
            <td>@request.TargetId</td>
            <td>@request.RequestedBy</td>
            <td>@request.DurationMinutes мин</td>
            <td>
                <span class="badge @statusBadge">@request.Status</span>
                <div class="d-flex gap-1 mt-1" style="max-width:160px">
                    @for (int i = 0; i < steps.Length; i++)
                    {
                        var color = currentStep == -1 ? (i == 0 ? "bg-danger" : "bg-light")
                            : i <= currentStep ? "bg-primary" : "bg-light";
                        <div class="@color rounded" style="height:4px;flex:1" title="@steps[i]"></div>
                    }
                </div>
            </td>
            <td>@request.ExpiresAt.ToString("u")</td>
            <td>@request.ItsmKey</td>
            <td>
                @if (request.Status.Equals("pending", StringComparison.OrdinalIgnoreCase))
                {
                    <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success">Approve</button>
                    </form>
                    <form method="post" asp-page-handler="Deny" asp-route-id="@request.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Deny</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

<h4 class="mt-4">Create access request</h4>
<form method="post" class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Target</label>
        <select asp-for="Form.TargetId" class="form-select">
            <option value="">-- select target --</option>
            @foreach (var target in Model.Targets)
            {
                <option value="@target.Id">@target.Name (@target.Id)</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Duration (мин)</label>
        <input asp-for="Form.DurationMinutes" class="form-control" type="number" min="5" max="1440" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Reason</label>
        <input asp-for="Form.Reason" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>
