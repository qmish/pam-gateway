@page
@model RecordingsModel
@{
    ViewData["Title"] = "Recordings";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Recordings</h2>
</div>

<form method="get" class="row g-3 mb-3">
    <div class="col-md-4">
        <label class="form-label">Search</label>
        <input asp-for="Search" class="form-control" placeholder="Id / SessionId" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="">All</option>
            @foreach (var status in Model.StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Mode</label>
        <select asp-for="Mode" class="form-select">
            <option value="">All</option>
            @foreach (var mode in Model.ModeOptions)
            {
                <option value="@mode">@mode</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
</form>

@if (Model.SelectedRecording is not null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Recording @Model.SelectedRecording.Id</h5>
            <div class="row">
                <div class="col-md-4"><strong>Status:</strong> @Model.SelectedRecording.Status</div>
                <div class="col-md-4"><strong>Mode:</strong> @Model.SelectedRecording.Mode</div>
                <div class="col-md-4"><strong>Session:</strong> @Model.SelectedRecording.SessionId</div>
            </div>
            <div class="row mt-2">
                <div class="col-md-4"><strong>Started:</strong> @Model.SelectedRecording.StartedAt.ToString("u")</div>
                <div class="col-md-4"><strong>Ended:</strong> @(Model.SelectedRecording.EndedAt?.ToString("u") ?? "-")</div>
                <div class="col-md-4"><strong>Size:</strong> @(Model.SelectedRecording.SizeBytes?.ToString() ?? "-")</div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12"><strong>Storage:</strong> @Model.SelectedRecording.StorageUri</div>
            </div>
            <div class="mt-3">
                @if (!string.IsNullOrWhiteSpace(Model.SelectedRecording.StorageUri))
                {
                    <a class="btn btn-sm btn-outline-primary"
                       href="@($"{Model.ApiPublicBaseUrl.TrimEnd('/')}/v1/recordings/{Model.SelectedRecording.Id}/content")">
                        Download
                    </a>
                }
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Id</th>
        <th>Session</th>
        <th>Mode</th>
        <th>Status</th>
        <th>Started At</th>
        <th>Ended At</th>
        <th>Size</th>
        <th>Storage</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var recording in Model.Recordings)
    {
        <tr>
            <td>@recording.Id</td>
            <td>@recording.SessionId</td>
            <td>@recording.Mode</td>
            <td>@recording.Status</td>
            <td>@recording.StartedAt.ToString("u")</td>
            <td>@(recording.EndedAt?.ToString("u") ?? "-")</td>
            <td>@(recording.SizeBytes?.ToString() ?? "-")</td>
            <td>@recording.StorageUri</td>
            <td>
                <a class="btn btn-sm btn-outline-secondary"
                   href="@Url.Page("/Recordings", new { SelectedId = recording.Id, Search = Model.Search, Status = Model.Status, Mode = Model.Mode })">
                    View
                </a>
                @if (!string.IsNullOrWhiteSpace(recording.StorageUri))
                {
                    <a class="btn btn-sm btn-outline-primary"
                       href="@($"{Model.ApiPublicBaseUrl.TrimEnd('/')}/v1/recordings/{recording.Id}/content")">
                        Download
                    </a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
